#!/usr/bin/env bash
# git-credential-vault — git credential helper backed by HashiCorp Vault.
#
# Serves a short-lived GitHub token fetched from Vault KV for HTTPS git
# operations against github.com. Installed by bootstrap.sh as a HOST-SCOPED
# helper (credential.https://github.com.helper), so git never invokes it for
# any other host.
#
# Requires (root-owned, mode 600 unless noted):
#   /etc/git-vault/config      KEY=value: VAULT_ADDR, GIT_VAULT_TOKEN_PATH,
#                              optional VAULT_CACERT   (mode 644 is fine)
#   /etc/git-vault/role-id     AppRole role_id
#   /etc/git-vault/secret-id   AppRole secret_id
#   /etc/git-vault/path-map    optional: "<repo path> <kv path>" per line —
#                              lets push hosts map one repo to a write token
#                              (requires: git config credential.https://github.com.useHttpPath true)
#
# Protocol: git credential-helper (get/store/erase on argv, key=value pairs on
# stdin until blank line). Only `get` for https://github.com is served; store/
# erase are silent no-ops. stdout carries ONLY protocol attributes. On fatal
# errors we emit `quit=true` so git stops instead of falling through to a
# terminal prompt (set GIT_TERMINAL_PROMPT=0 in cron anyway).

set -euo pipefail
{ set +x; } 2>/dev/null   # never let an inherited xtrace print secrets

CONF_DIR=/etc/git-vault

fail() {
  printf 'git-credential-vault: %s\n' "$*" >&2
  printf 'quit=true\n'
  exit 1
}
# Any UNguarded failure must still stop git from falling through to a
# terminal prompt (guarded `|| fail` paths never trigger ERR).
trap 'printf "quit=true\n"; exit 1' ERR

ACTION="${1:-}"
# store/erase (and anything unknown): consume stdin, do nothing, succeed.
if [[ "$ACTION" != "get" ]]; then cat >/dev/null; exit 0; fi

# --- parse request (first '=' only; ignore unknown/repeated keys) -------------
proto="" host="" repo_path=""
while IFS= read -r line; do
  [[ -z "$line" ]] && break
  key="${line%%=*}" ; val="${line#*=}"
  case "$key" in
    protocol) proto="$val" ;;
    host)     host="$val" ;;
    path)     repo_path="$val" ;;
    *)        : ;;   # url=, wwwauth[], capability[], username=... — ignored
  esac
done

# Not ours (defense in depth — the scoped config should prevent this call).
if [[ "$proto" != "https" || ( "$host" != "github.com" && "$host" != "github.com:443" ) ]]; then
  exit 0
fi

[[ $EUID -eq 0 ]] || fail "requires root (credential files are root-only); non-root git to github.com is not supported on this host"
[[ -f $CONF_DIR/config    ]] || fail "$CONF_DIR/config missing — run the keyvault bootstrap"
[[ -f $CONF_DIR/role-id   ]] || fail "$CONF_DIR/role-id missing — see RUNBOOK-GITHUB-ACCESS step 4"
[[ -f $CONF_DIR/secret-id ]] || fail "$CONF_DIR/secret-id missing — see RUNBOOK-GITHUB-ACCESS step 4"
command -v vault   >/dev/null || fail "vault CLI not installed — run the keyvault bootstrap"
command -v python3 >/dev/null || fail "python3 required"

# config is sourced as root — refuse anything not root-owned/root-writable-only
# (a writable config or credential file is root code/credential compromise).
for f in "$CONF_DIR/config" "$CONF_DIR/role-id" "$CONF_DIR/secret-id"; do
  perms=$(stat -c '%u %a' "$f" 2>/dev/null || stat -f '%u %Lp' "$f")
  read -r owner mode <<< "$perms"
  [[ "$owner" == "0" ]] || fail "$f not owned by root"
  grp="${mode: -2:1}" ; oth="${mode: -1}"
  if [[ "$grp" == [2367] || "$oth" == [2367] ]]; then
    fail "$f is group/world-writable (mode $mode)"
  fi
done

# shellcheck source=/dev/null
source "$CONF_DIR/config" >/dev/null   # stdout stays protocol-pure even if config misbehaves
[[ -n "${VAULT_ADDR:-}" ]] || fail "VAULT_ADDR not set in $CONF_DIR/config"
export VAULT_ADDR ${VAULT_CACERT:+VAULT_CACERT}

# --- pick the KV path: per-repo override (push hosts) or fleet default --------
token_path="${GIT_VAULT_TOKEN_PATH:-}"
if [[ -n "$repo_path" && -f "$CONF_DIR/path-map" ]]; then
  # ENVIRON[] (not -v): awk -v expands backslash escapes in the value; a repo
  # path is data, never program text. $1==r is full-field equality — no
  # pattern matching, no injection surface.
  mapped=$(GCV_REPO="$repo_path" awk \
    '!/^[[:space:]]*(#|$)/ && $1 == ENVIRON["GCV_REPO"] { print $2; exit }' \
    "$CONF_DIR/path-map" || true)
  if [[ -n "$mapped" ]]; then
    [[ "$mapped" =~ ^[A-Za-z0-9/_.-]+$ ]] || fail "path-map entry for '$repo_path' has an invalid KV path"
    token_path="$mapped"
  fi
fi
[[ -n "$token_path" ]] || fail "GIT_VAULT_TOKEN_PATH not set in $CONF_DIR/config"

# --- vault login (short token; best-effort revoke, 10m TTL is the backstop) ---
VAULT_TOKEN="$(vault write -field=token auth/approle/login \
    role_id=@"$CONF_DIR/role-id" secret_id=@"$CONF_DIR/secret-id" 2>/dev/null)" \
  || fail "Vault AppRole login failed (Vault down? bad/revoked credentials? CIDR mismatch?) — addr: $VAULT_ADDR"
export VAULT_TOKEN
trap 'vault token revoke -self >/dev/null 2>&1 || true' EXIT

# --- single atomic KV read, validate freshness, emit ---------------------------
kv_json="$(vault kv get -format=json "$token_path" 2>/dev/null)" \
  || fail "cannot read $token_path (policy? path?)"

# stdout below this point is protocol-pure: the parser prints ONLY attribute
# lines (username/password/password_expiry_utc; the expiry line lets git >=2.41
# refuse cached credentials when chained behind an optional `cache` helper).
parsed="$(printf '%s' "$kv_json" | python3 -c '
import sys, json, datetime
path = sys.argv[1]
data = json.load(sys.stdin)["data"]["data"]
token, user, expires = data.get("token"), data.get("username"), data.get("expires")
if not token or not user or not expires:
    print(f"malformed secret at {path} (need token/username/expires)", file=sys.stderr)
    sys.exit(1)
# A newline inside a value would inject extra attributes (incl. url=) into
# the git credential protocol stream (NO apostrophes in this quoted block) — refuse.
if any(c in v for v in (token, user, expires) for c in "\r\n"):
    print(f"secret at {path} contains newline characters — refusing", file=sys.stderr)
    sys.exit(1)
exp = datetime.datetime.strptime(expires, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
now = datetime.datetime.now(datetime.timezone.utc)
if (exp - now).total_seconds() < 60:
    print(f"github token stale (expires {expires}) — check the renewer timer on the renewer host", file=sys.stderr)
    sys.exit(2)
print(f"username={user}")
print(f"password={token}")
print(f"password_expiry_utc={int(exp.timestamp())}")
' "$token_path")" || fail "token unusable — see message above"

printf '%s\n' "$parsed"
